# Binance API Credentials (Optional for public market data, required for private streams/orders)
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_API_SECRET=your_binance_api_secret_here

# Trading Pair & Order Book Settings
SYMBOL=BTCUSDT
ORDER_BOOK_DEPTH=20

# Data Storage Settings
DATA_DIR=./data
STORAGE_TYPE=parquet  # Options: sqlite, parquet
