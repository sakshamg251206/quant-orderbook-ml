# Copy to .env and adjust. Every variable is optional; the values below are the defaults.
# No API key is needed: the project only reads public market data.

# Workspace directory for snapshots, datasets, models, reports and predictions.
OBML_DATA_DIR=data

# Market to record and score (Binance spot symbol).
OBML_SYMBOL=BTCUSDT

# Price levels stored per side of the book (features use the top 20).
OBML_DEPTH=20

# How often the local order book is sampled, in milliseconds.
OBML_SNAPSHOT_INTERVAL_MS=100

# Snapshots buffered in memory before each Parquet file is written (600 = 1 min at 100 ms).
OBML_BATCH_SIZE=600

# Binance endpoints. Binance blocks some regions (HTTP 451); point these at an endpoint
# that serves your region if needed, e.g. https://api.binance.us and wss://stream.binance.us:9443
OBML_BINANCE_REST_URL=https://api.binance.com
OBML_BINANCE_WS_URL=wss://stream.binance.com:9443

# Signal thresholds on the predicted probability of an up move.
OBML_BUY_THRESHOLD=0.60
OBML_SELL_THRESHOLD=0.40

# DEBUG, INFO, WARNING or ERROR.
OBML_LOG_LEVEL=INFO
